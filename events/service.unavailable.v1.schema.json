{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/events/service.unavailable.v1.schema.json",
  "title": "ServiceUnavailableEvent",
  "allOf": [
    { "$ref": "./envelope.v1.schema.json" },
    {
      "type": "object",
      "required": ["eventType", "payload"],
      "properties": {
        "eventType": { "const": "service.unavailable" },
        "payload": {
          "allOf": [
            { "$ref": "../schemas/health-status.v1.schema.json" },
            { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["unhealthy", "unknown"] } } }
          ]
        }
      }
    }
  ]
}
