{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/events/incident.resolved.v1.schema.json",
  "title": "IncidentResolvedEvent",
  "allOf": [
    { "$ref": "./envelope.v1.schema.json" },
    {
      "type": "object",
      "required": ["eventType", "eventVersion", "payload"],
      "properties": {
        "eventType": { "const": "incident.resolved" },
        "eventVersion": { "const": "1.0.0" },
        "payload": {
          "allOf": [
            { "$ref": "../schemas/incident.v1.schema.json" },
            { "type": "object", "required": ["status", "resolvedAt"], "properties": {
              "status": { "const": "resolved" },
              "resolvedAt": { "$ref": "../schemas/incident.v1.schema.json#/properties/resolvedAt" }
            } }
          ]
        }
      }
    }
  ]
}
