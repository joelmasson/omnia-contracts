{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/events/backup.failed.v1.schema.json",
  "title": "BackupFailedEvent",
  "allOf": [
    { "$ref": "./envelope.v1.schema.json" },
    { "type": "object", "required": ["eventType", "eventVersion", "payload"], "properties": {
      "eventType": { "const": "backup.failed" },
      "eventVersion": { "const": "1.0.0" },
      "payload": { "allOf": [
        { "$ref": "../schemas/backup.v1.schema.json" },
        { "type": "object", "required": ["status", "verificationStatus", "failure"], "properties": {
          "status": { "const": "failed" },
          "verificationStatus": { "const": "not_requested" },
          "failure": { "$ref": "../schemas/backup.v1.schema.json#/properties/failure" }
        } }
      ] }
    } }
  ]
}
