{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/events/job.progress.v1.schema.json",
  "title": "JobProgressEvent",
  "allOf": [
    { "$ref": "./envelope.v1.schema.json" },
    {
      "type": "object",
      "required": ["eventType", "eventVersion", "payload"],
      "properties": {
        "eventType": { "const": "job.progress" },
        "eventVersion": { "const": "1.0.0" },
        "payload": {
          "type": "object",
          "required": ["jobKey", "executionId", "sequence", "stage", "stageIndex", "stageCount", "status"],
          "properties": {
            "jobKey": { "type": "string", "minLength": 1 },
            "executionId": { "type": "string", "minLength": 1 },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "stage": {
              "type": "string",
              "enum": [
                "nhle",
                "moneypuck",
                "nst",
                "skater-stats",
                "goalie-stats",
                "goalie-starts",
                "goalie-storage",
                "player-storage",
                "standings",
                "schedule",
                "goalie-coverage",
                "advanced-sources",
                "advanced-recompute"
              ]
            },
            "stageIndex": {
              "type": "integer",
              "minimum": 1,
              "description": "Stable stage catalog position, must not exceed stageCount, and does not determine execution order; the first six stages may run concurrently."
            },
            "stageCount": { "type": "integer", "minimum": 1 },
            "status": { "type": "string", "enum": ["started", "completed"] },
            "recordsProcessed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Non-negative safe integer representing the stage total."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
