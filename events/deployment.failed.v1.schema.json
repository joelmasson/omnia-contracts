{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/events/deployment.failed.v1.schema.json",
  "title": "DeploymentFailedEvent",
  "allOf": [
    { "$ref": "./envelope.v1.schema.json" },
    { "type": "object", "required": ["eventType", "eventVersion", "payload"], "properties": {
      "eventType": { "const": "deployment.failed" },
      "eventVersion": { "const": "1.0.0" },
      "payload": { "allOf": [
        { "$ref": "../schemas/deployment.v1.schema.json" },
        { "type": "object", "required": ["status", "completedAt"], "properties": {
          "status": { "const": "failed" },
          "completedAt": { "$ref": "../schemas/deployment.v1.schema.json#/properties/completedAt" }
        } }
      ] }
    } }
  ]
}
