{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/schemas/event-feed-query.v1.schema.json",
  "title": "EventFeedQuery",
  "type": "object",
  "required": ["after"],
  "properties": {
    "after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Last acknowledged global feed position; use 0 for the first request."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 100,
      "description": "Maximum events to return; defaults to 100 and cannot exceed 100."
    }
  },
  "additionalProperties": false
}
