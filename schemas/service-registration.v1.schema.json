{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omnia.dev/schemas/service-registration.v1.schema.json",
  "title": "ServiceRegistration",
  "type": "object",
  "required": ["serviceId", "name", "version", "description", "healthEndpoint", "apiEndpoint", "deploymentType", "status", "registeredAt", "metadata"],
  "properties": {
    "serviceId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "description": "Service release version following Semantic Versioning 2.0.0.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": { "type": "string" },
    "healthEndpoint": { "type": "string", "format": "uri", "pattern": "^https?://[^/?#\\s@]+(?:[/?#]|$)" },
    "apiEndpoint": { "type": "string", "format": "uri", "pattern": "^https?://[^/?#\\s@]+(?:[/?#]|$)" },
    "deploymentType": { "type": "string", "minLength": 1, "description": "Opaque deployment mechanism label, not a platform-specific enum." },
    "status": { "type": "string", "enum": ["starting", "running", "stopping", "stopped", "unknown"] },
    "registeredAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
